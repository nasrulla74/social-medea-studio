{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",

  "appId": "com.socialmedea.studio",
  "productName": "Social Medea Studio",
  "executableName": "social-medea-studio",

  "asar": true,

  "directories": {
    "output": "release/${version}"
  },

  "files": [
    "dist",
    "dist-electron"
  ],

  "mac": {
    "target": [
      "dmg"
    ],
    "artifactName": "Social-Medea-Studio-${version}-macOS-${arch}.${ext}"
  },

  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "Social-Medea-Studio-${version}-Windows-${arch}.${ext}"
  },

  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },

  "linux": {
    "category": "Office",
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "Social-Medea-Studio-${version}-Linux-${arch}.${ext}"
  }
}
