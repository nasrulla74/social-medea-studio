{
  "name": "social-medea-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run prepare:shared && vite",
    "build": "pnpm run prepare:shared && pnpm run typecheck && vite build && electron-builder",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "pnpm run prepare:shared && tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "prepare:shared": "pnpm --filter @social-medea/shared-types run build"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@social-medea/shared-types": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.2",
    "lucide-react": "1.78.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vite-plugin-electron": "1.2.0"
  },
  "main": "dist-electron/main.js",
  "description": "AI-powered social media agency management platform",
  "productName": "Social Medea Studio",
  "author": "Social Medea"
}
